<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="aosp"
        fetch="https://android.googlesource.com" />
  
    <!-- lineage feels much better choice than bare aosp -->
  
    <remote name="github"
        fetch=".."
        review="review.lineageos.org" />

    <remote name="nang"
        fetch="https://github.com/nangAOSP" />

    <default remote="aosp"
        revision="refs/heads/main"
        sync-j="8" />

    <!-- AOSP platform projects -->
    <project path="build/make" name="platform/build" />
    <project path="frameworks/base" name="platform/frameworks/base" />
    <project path="packages/apps/Settings" name="platform/packages/apps/Settings" />

    <!-- ROM-specific overrides -->
    <remove-project name="platform/frameworks/base" />
    
    <project path="frameworks/base"
        name="android_frameworks_base"
        remote="nang"
        revision="main" />

    <!-- ROM vendor repo -->
    <project path="vendor/nang"
        name="android_vendor_nang"
        remote="nang"
        revision="main" />
</manifest>